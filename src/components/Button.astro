---
// ============================================================
// Button — 共通ボタン（グラデーションは使わず、落ち着いた単色）
// ============================================================
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  external?: boolean;
  arrow?: boolean;
  size?: 'md' | 'sm';
}

const { href, label, variant = 'primary', external = false, arrow = true, size = 'md' } = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-300';

const sizes = {
  md: 'px-6 py-3 text-sm',
  sm: 'px-5 py-2.5 text-xs',
};

const variants = {
  primary: 'bg-blue text-on-blue hover:bg-blue-deep',
  secondary: 'border border-line bg-surface text-ink hover:border-blue/50 hover:text-blue',
  ghost: 'text-muted hover:text-blue',
};

const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---

<a href={href} {...ext} class={`${base} ${sizes[size]} ${variants[variant]}`}>
  <span>{label}</span>
  {
    arrow && (
      <span class="k-arrow transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
        →
      </span>
    )
  }
</a>
