---
// ============================================================
// SectionHeading — 英字ラベル + 日本語見出し
// ============================================================
interface Props {
  label?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { label, title, description, align = 'left' } = Astro.props;
const isCenter = align === 'center';
---

<div class={`max-w-2xl ${isCenter ? 'mx-auto text-center' : ''}`} data-reveal>
  {label && <p class="eyebrow mb-4">{label}</p>}
  <h2 class="palt font-display text-2xl font-semibold leading-snug text-ink md:text-3xl">
    {title}
  </h2>
  <span
    class={`mt-5 block h-1 w-12 rounded-full ${isCenter ? 'mx-auto' : ''}`}
    style="background-image: linear-gradient(90deg, #2563EB, #0EA5A5)"
  ></span>
  {description && <p class="mt-6 leading-relaxed text-muted">{description}</p>}
</div>
