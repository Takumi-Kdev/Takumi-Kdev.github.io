---
// ============================================================
// Timeline — 歩み
// ============================================================
interface Props {
  items: readonly { when: string; what: string }[];
}

const { items } = Astro.props;
---

<ol class="relative border-l border-line pl-6">
  {
    items.map((item, i) => (
      <li class="relative pb-8 last:pb-0" data-reveal style={`transition-delay: ${i * 60}ms`}>
        <span
          class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full"
          style="background-image: linear-gradient(135deg, #2563EB, #0EA5A5)"
          aria-hidden="true"
        ></span>
        <p class="text-xs text-faint">{item.when}</p>
        <p class="mt-1 text-sm leading-relaxed text-muted">{item.what}</p>
      </li>
    ))
  }
</ol>
