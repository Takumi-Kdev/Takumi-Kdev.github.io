---
// ============================================================
// FilterTabs — 作品一覧のフィルタ（クライアント側）
// ============================================================
const TABS = [
  { key: 'all', label: 'All', labelJa: 'すべて' },
  { key: 'ai', label: 'AI', labelJa: 'AI・自動化' },
  { key: 'app', label: 'App', labelJa: 'アプリ' },
  { key: 'web', label: 'Web', labelJa: 'Web' },
] as const;
---

<div class="flex flex-wrap gap-2" role="tablist" aria-label="作品の絞り込み" data-reveal>
  {
    TABS.map((tab, i) => (
      <button
        type="button"
        role="tab"
        data-filter={tab.key}
        aria-selected={i === 0 ? 'true' : 'false'}
        class="filter-tab rounded-full border border-line bg-surface px-4 py-2 font-display text-xs text-muted transition-all duration-200 hover:border-cobalt/50 hover:text-cobalt aria-selected:border-transparent aria-selected:text-white"
      >
        <span>{tab.label}</span>
        <span class="ml-1.5 text-[10px] opacity-70">{tab.labelJa}</span>
      </button>
    ))
  }
</div>

<style>
  @layer components {
    .filter-tab[aria-selected='true'] {
      background-image: linear-gradient(135deg, #2563eb 0%, #4f46e5 48%, #0ea5a5 100%);
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const items = document.querySelectorAll<HTMLElement>('[data-project]');

  const apply = (key: string) => {
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.filter === key)));
    items.forEach((item) => {
      const show = key === 'all' || item.dataset.project === key;
      item.style.display = show ? '' : 'none';
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => apply(tab.dataset.filter ?? 'all'));
  });
</script>
