---
// ============================================================
// FilterTabs — 作品一覧のフィルタ（下線スタイル）
// ============================================================
const TABS = [
  { key: 'all', label: 'すべて' },
  { key: 'ai', label: 'AI・自動化' },
  { key: 'app', label: 'アプリ' },
  { key: 'web', label: 'Web' },
] as const;
---

<div class="flex flex-wrap gap-6 border-b border-line" role="tablist" aria-label="作品の絞り込み" data-reveal>
  {
    TABS.map((tab, i) => (
      <button
        type="button"
        role="tab"
        data-filter={tab.key}
        aria-selected={i === 0 ? 'true' : 'false'}
        class="filter-tab -mb-px border-b-2 border-transparent px-0.5 pb-3 text-sm text-muted transition-colors hover:text-ink aria-selected:border-blue aria-selected:font-medium aria-selected:text-ink"
      >
        {tab.label}
      </button>
    ))
  }
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const items = document.querySelectorAll<HTMLElement>('[data-project]');

  const apply = (key: string) => {
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.filter === key)));
    items.forEach((item) => {
      const show = key === 'all' || item.dataset.project === key;
      item.style.display = show ? '' : 'none';
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => apply(tab.dataset.filter ?? 'all'));
  });
</script>
