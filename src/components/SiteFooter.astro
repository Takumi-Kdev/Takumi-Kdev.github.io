---
// ============================================================
// SiteFooter
// ============================================================
import { NAV, SITE } from '../data/site';
import Monogram from './Monogram.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface/60">
  <div class="shell py-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <Monogram size={44} decorative />
          <div class="leading-tight">
            <p class="font-display text-xl font-semibold">{SITE.handle}</p>
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted">
              {SITE.nameJa} / {SITE.region}
            </p>
          </div>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted">
          {SITE.taglineJa} — {SITE.leadEn}
        </p>
      </div>

      <nav class="md:col-span-3" aria-label="サイト内リンク">
        <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-faint">Pages</h3>
        <ul class="mt-4 space-y-3">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-display text-sm text-muted transition-colors hover:text-cobalt"
                >
                  {item.label}
                  <span class="ml-2 text-xs text-faint">{item.labelJa}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="md:col-span-4" aria-label="外部リンク">
        <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-faint">Elsewhere</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={SITE.github}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-display text-sm text-muted transition-colors hover:text-cobalt"
            >
              <span class="ph ph-github-logo text-base" aria-hidden="true"></span>
              GitHub
            </a>
          </li>
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="inline-flex items-center gap-2 font-display text-sm text-muted transition-colors hover:text-cobalt"
            >
              <span class="ph ph-envelope-simple text-base" aria-hidden="true"></span>
              Mail
            </a>
          </li>
          <li>
            <a
              href={SITE.koodoUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-display text-sm text-muted transition-colors hover:text-cobalt"
            >
              <span class="ph ph-briefcase text-base" aria-hidden="true"></span>
              巧黄土（仕事の依頼）
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col justify-between gap-3 border-t border-line pt-6 font-mono text-[11px] text-faint sm:flex-row"
    >
      <span>© {year} {SITE.handle}</span>
      <span class="flex items-center gap-4">
        <span>Built with Astro</span>
        <a href="/sitemap-index.xml" class="transition-colors hover:text-cobalt">Sitemap</a>
      </span>
    </div>
  </div>
</footer>
