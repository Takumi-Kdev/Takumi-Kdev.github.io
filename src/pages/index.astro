---
// ============================================================
// ホーム
// ============================================================
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Monogram from '../components/Monogram.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import KoodoBand from '../components/KoodoBand.astro';
import { SITE } from '../data/site';
import { SKILLS_CAN } from '../data/skills';
import { NOW } from '../data/now';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = projects.slice(0, 3);
const chips = SKILLS_CAN.flatMap((g) => g.items).slice(0, 6);
---

<BaseLayout>
  <!-- ═══════════ ヒーロー ═══════════ -->
  <section class="soft-wash border-b border-line">
    <div class="shell py-20 md:py-28">
      <div class="max-w-2xl" data-reveal>
        <div class="flex items-center gap-3">
          <Monogram size={52} decorative />
          <div class="leading-tight">
            <p class="font-display text-2xl font-semibold tracking-tight text-ink">
              {SITE.handle}
            </p>
            <p class="text-xs text-muted">{SITE.nameJa} ／ {SITE.titleJa}</p>
          </div>
        </div>

        <h1 class="palt mt-12 font-display text-3xl font-semibold leading-snug text-ink md:text-[2.6rem]">
          {SITE.taglineJa}
        </h1>
        <p class="mt-6 leading-relaxed text-muted">
          {SITE.leadJa}
        </p>
        <p class="mt-2 text-sm text-faint" lang="en">{SITE.leadEn}</p>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <Button href="/projects" label="作品を見る" variant="primary" />
          <Button href="/contact" label="連絡する" variant="secondary" />
        </div>

        <div class="mt-10 flex flex-wrap gap-2">
          {chips.map((c) => <span class="k-tag">{c}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 作品 ═══════════ -->
  <section class="section">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          label="作品"
          title="つくってきたもの。"
          description="すべて個人開発のプロジェクトです。設計の理由や、つまずいた点も書いています。"
        />
        <a
          href="/projects"
          class="k-arrow-link mb-2 hidden items-center gap-2 text-sm text-muted transition-colors hover:text-blue md:inline-flex"
        >
          すべての作品
          <span class="k-arrow">→</span>
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ═══════════ About（短縮） ═══════════ -->
  <section class="section border-y border-line">
    <div class="shell">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-5" data-reveal>
          <SectionHeading
            label="私について"
            title="つくるのが、好きです。"
            description="パソコンが好きで、AIでつくることに夢中になって、気づけば毎日システムをつくっています。高校生。愛知県豊橋市。"
          />
          <div class="mt-7">
            <Button href="/about" label="もっと知る" variant="secondary" size="sm" />
          </div>
        </div>
        <div class="space-y-5 md:col-span-7" data-reveal>
          {
            [
              { title: 'その日のうちに形にする', body: '考えたことを、まず動くところまでつくってみる。' },
              { title: '設計もコードも公開する', body: 'つくったものは、中身まで見える形で残しておきたい。' },
              { title: 'うまくいかなかったことも書く', body: 'つまずいた記録のほうが、あとで誰かの役に立つ。' },
            ].map((item) => (
              <div class="flex gap-4">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue" aria-hidden="true"></span>
                <div>
                  <p class="font-medium text-ink">{item.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{item.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ Now（短縮） ═══════════ -->
  <section class="section">
    <div class="shell">
      <SectionHeading label="いま" title="いま、やっていること。" />
      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          NOW.items.slice(0, 3).map((item, i) => (
            <div class="k-card p-6" data-reveal style={`transition-delay: ${i * 70}ms`}>
              <span class="k-tag">{item.tag}</span>
              <p class="mt-4 text-sm leading-relaxed text-muted">{item.text}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8" data-reveal>
        <a
          href="/now"
          class="k-arrow-link inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-blue"
        >
          すべて見る（{NOW.updatedAt} 更新）
          <span class="k-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <KoodoBand />
</BaseLayout>
