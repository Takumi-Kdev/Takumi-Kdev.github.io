---
// ============================================================
// About
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import Monogram from '../components/Monogram.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import KoodoBand from '../components/KoodoBand.astro';
import { SITE, TIMELINE, VALUES } from '../data/site';
import { SKILLS_CAN, SKILLS_LEARNING } from '../data/skills';
---

<BaseLayout
  title="About — Takumi-Kdev"
  description="Takumi-Kdev（河合巧実）のプロフィール。高校生開発者として、AIとWebのシステムを個人開発しています。歩み・大切にしていること・できることをまとめました。"
>
  <!-- ヒーロー -->
  <section class="relative overflow-hidden hero-veil">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <span class="aurora-blob left-[5%] top-[-25%] h-[24rem] w-[24rem] bg-sky"></span>
      <span
        class="aurora-blob right-[-5%] top-[10%] h-[20rem] w-[20rem] bg-indigo"
        style="animation-delay: -12s"
      ></span>
    </div>

    <div class="shell relative py-16 md:py-24">
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
        <div class="flex justify-center md:col-span-4" data-reveal>
          <div class="grad-border flex h-44 w-44 items-center justify-center rounded-3xl">
            <Monogram size={104} decorative />
          </div>
        </div>
        <div class="md:col-span-8" data-reveal>
          <p class="eyebrow mb-4">About</p>
          <h1 class="palt font-display text-3xl font-semibold text-ink md:text-4xl">
            {SITE.handle}
          </h1>
          <p class="mt-3 font-display text-lg text-muted">
            {SITE.nameJa} — {SITE.titleJa}
          </p>
          <p class="mt-6 max-w-xl leading-relaxed text-muted">
            パソコンが好きで、AIでつくることに夢中になって、気づけば仕事になりました。
            いまは、AIとWebのシステムを個人開発しています。
            新しい技術を、誰よりも柔軟に、誠実に使うこと。それが、いちばんの得意です。
          </p>
          <p class="mt-4 font-mono text-xs text-faint">{SITE.region} ／ 個人開発</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section">
    <div class="shell">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-4" data-reveal>
          <SectionHeading label="Story" title="はじまり。" />
        </div>
        <div class="space-y-5 leading-relaxed text-muted md:col-span-8" data-reveal>
          <p>
            もともとパソコンが好きでした。ある日、AIでWebサイトを作ってみたら、
            面白すぎて沼にはまりました。そこから、つくりたいと思ったものを
            その日のうちに形にする毎日がはじまりました。
          </p>
          <p>
            つくっていると、うまくいかないことのほうが多いです。
            それでも、小さく動かして、確かめて、直していく。
            その繰り返しで、少しずつ「動くもの」が増えていきます。
          </p>
          <p>
            つくったものは、設計もコードも公開しています。
            できること・できないことを正直に書くのは、
            見てくれる人が正しく判断できるようにしたいからです。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section">
    <div class="shell">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-4" data-reveal>
          <SectionHeading label="Timeline" title="これまでの歩み。" />
        </div>
        <div class="md:col-span-8" data-reveal>
          <Timeline items={TIMELINE} />
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section">
    <div class="shell">
      <SectionHeading
        label="Skills"
        title="できること・学んでいること。"
        description="できることは正直に、できないことも正直に。"
      />

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          SKILLS_CAN.map((group, i) => (
            <section class="k-card p-7" data-reveal style={`transition-delay: ${i * 60}ms`}>
              <h3 class="font-display text-base font-semibold text-ink">{group.title}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => <li class="k-tag">{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="grad-border mt-6 rounded-2xl p-7" data-reveal>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-cobalt">
          Learning — これから
        </p>
        <ul class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
          {
            SKILLS_LEARNING.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-muted">
                <span class="ph ph-book-open mt-0.5 text-base text-teal" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section">
    <div class="shell">
      <SectionHeading label="Values" title="大切にしていること。" />
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          VALUES.map((value, i) => (
            <section class="k-card p-7" data-reveal style={`transition-delay: ${i * 70}ms`}>
              <span class="font-mono text-xs text-cobalt">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-base font-semibold text-ink">{value.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{value.body}</p>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <KoodoBand />
</BaseLayout>
