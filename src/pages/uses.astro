---
// ============================================================
// Uses — 開発環境・道具
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ToolList from '../components/ToolList.astro';
import KoodoBand from '../components/KoodoBand.astro';
import { USES } from '../data/uses';
---

<BaseLayout
  title="Uses — Takumi-Kdev"
  description="Takumi-Kdev の開発環境。ハードウェア、エディタ、言語、AIツールなど、どうやってつくっているかをまとめています。"
>
  <section class="relative overflow-hidden soft-wash">
    <div class="shell relative pb-10 pt-14 md:pt-20">
      <div data-reveal>
        <Breadcrumbs items={[{ label: '道具' }]} />
      </div>
      <div class="mt-8">
        <SectionHeading
          level="h1"
          label="道具"
          title="どうやって、つくっているか。"
          description="道具は、考え方を映すと思っています。いま使っているものをまとめました。"
        />
      </div>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="shell">
      <ToolList groups={USES} />
    </div>
  </section>

  <KoodoBand />
</BaseLayout>
