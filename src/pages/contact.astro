---
// ============================================================
// Contact
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Contact — Takumi-Kdev"
  description="Takumi-Kdev への連絡先。開発についての相談は GitHub またはメールへ。仕事の依頼は巧黄土で受け付けています。"
>
  <section class="relative overflow-hidden soft-wash">

    <div class="shell relative py-16 md:py-24">
      <div data-reveal>
        <Breadcrumbs items={[{ label: '連絡' }]} />
      </div>

      <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-6" data-reveal>
          <SectionHeading
            level="h1"
            title="お気軽に、どうぞ。"
            description="開発のこと、OSSのこと、学びのこと。メールかGitHubからどうぞ。"
          />
          <div class="mt-9 space-y-4">
            <a
              href={`mailto:${SITE.email}`}
              class="k-card flex items-center gap-4 p-5"
            >
              <span class="ph ph-envelope-simple text-xl text-blue" aria-hidden="true" />
              <span>
                <span class="block font-display text-sm text-ink">Mail</span>
                <span class="mt-0.5 block break-all font-mono text-xs text-muted">{SITE.email}</span>
              </span>
            </a>
            <a
              href={SITE.github}
              target="_blank"
              rel="noopener"
              class="k-card flex items-center gap-4 p-5"
            >
              <span class="ph ph-github-logo text-xl text-blue" aria-hidden="true" />
              <span>
                <span class="block font-display text-sm text-ink">GitHub</span>
                <span class="mt-0.5 block font-mono text-xs text-muted">github.com/Takumi-Kdev</span>
              </span>
            </a>
          </div>
        </div>

        <div class="md:col-span-6" data-reveal>
          <div class="k-card rounded-3xl p-8">
            <p class="label mb-4">For business</p>
            <h2 class="palt font-display text-xl font-semibold text-ink">
              仕事の依頼は、巧黄土で。
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              ホームページ制作、業務の自動化、AIの使い方相談。
              お店や会社の「困った」を、いっしょに解決しています。
            </p>
            <div class="mt-7">
              <Button href={SITE.koodoUrl} label="巧黄土を見る" external variant="primary" size="sm" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
