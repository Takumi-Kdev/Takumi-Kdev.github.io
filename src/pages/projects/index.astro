---
// ============================================================
// 作品一覧
// ============================================================
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FilterTabs from '../../components/FilterTabs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import KoodoBand from '../../components/KoodoBand.astro';
import { itemListJsonLd } from '../../utils/seo';
import { SITE } from '../../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const jsonLd = [
  itemListJsonLd(
    '作品一覧',
    projects.map((p) => ({
      name: p.data.title,
      url: `${SITE.url}/projects/${p.id}/`,
    }))
  ),
];
---

<BaseLayout
  title="作品 — Takumi-Kdev"
  description="Takumi-Kdev の個人開発プロジェクト一覧。AIシステム、業務自動化、アプリ開発の設計と実装をまとめています。"
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden soft-wash">

    <div class="shell relative pb-10 pt-14 md:pt-20">
      <div data-reveal>
        <Breadcrumbs items={[{ label: '作品' }]} />
      </div>
      <div class="mt-8">
        <SectionHeading
          level="h1"
          label="作品"
          title="つくってきたもの。"
          description="すべて個人開発のプロジェクトです。何を考えて、どうつくったかまで書いています。"
        />
      </div>
      <div class="mt-9">
        <FilterTabs />
      </div>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="shell">
      <h2 class="sr-only">作品一覧</h2>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </section>

  <KoodoBand />
</BaseLayout>
